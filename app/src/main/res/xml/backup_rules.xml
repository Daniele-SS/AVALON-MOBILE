<?xml version="1.0" encoding="utf-8"?>
<!-- A sessão é cifrada com chave do Android Keystore, que não é restaurável em outro aparelho:
     fica fora do backup para evitar sessão corrompida após restauração. -->
<full-backup-content>
    <exclude domain="sharedpref" path="avalon_secure_session.xml" />
</full-backup-content>
